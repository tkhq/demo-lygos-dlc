out
.claude
target
*.log
local-enclave

# Credentials. `--pivot-pull-secret` takes a file holding a GitHub PAT in
# cleartext, and the README tells you to create one, so keep it uncommittable.
.env
.env.*
pull-secret*.json
*.pem
*.p12
*.key

# Deployment identity. Org, app, operator and manifest-set ids, plus operator
# public keys. Not secrets, but this repo is public and they say who deploys it
# rather than anything about the demo. See tvc-configs/local.env.example.
tvc-configs/local.env
tvc-configs/*.local.json
tvc-configs/.rendered.*.json

# Generated by frontend/build.sh, and names whichever enclave you point at.
frontend/config.js
