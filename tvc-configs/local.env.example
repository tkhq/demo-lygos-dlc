# Deployment identity. Copy to local.env, which is gitignored, and fill in.
#
#   cp tvc-configs/local.env.example tvc-configs/local.env
#
# Nothing here is secret. The public keys are public halves and the ids are
# identifiers rather than credentials. They live outside the repo because a
# public demo has no reason to publish which org and operator deploy it.
#
# Anyone deploying their own copy fills these in with their own values. None of
# it is needed to run the app locally or to read the code.

# Turnkey org that owns each app. `tvc login` has to target the matching one.
# Production defaults to https://api.turnkey.com.
PROD_ORG_ID=
DEV_ORG_ID=

# App ids, from `tvc app list` or the output of `tvc app create`.
PROD_APP_ID=
DEV_APP_ID=

# Operator ids, used to approve a deployment. Printed by `tvc app create`.
PROD_OPERATOR_ID=
DEV_OPERATOR_ID=

# Manifest set ids, recorded at app creation.
PROD_MANIFEST_SET_ID=
DEV_MANIFEST_SET_ID=

# Operator public keys, substituted into app.json at creation time. Take these
# from `tvc operator list` or from the key you generated for approvals.
PROD_OPERATOR_PUBKEY=
DEV_OPERATOR_PUBKEY=

# App URLs, for pointing the frontend at a deployment. Stable per app, so these
# only change when the app does.
PROD_APP_URL=
DEV_APP_URL=
